{
  "name": "@duovino/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "DuoVino design system — React component library for the WSET Study Guide.",
  "type": "module",
  "module": "dist/index.es.js",
  "main": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js"
    },
    "./styles.css": "./src/duovino.css"
  },
  "files": [
    "dist",
    "src/duovino.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist --external react --external react-dom && node -e \"require('fs').renameSync('dist/index.js','dist/index.es.js')\"",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
